{
  "name": "big-ppt",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "dev": "pnpm -F @big-ppt/shared build && turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test --concurrency=1",
    "lint": "turbo run lint",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "type-check": "turbo run type-check",
    "gen:thumbnails": "tsx scripts/generate-template-thumbnails.ts",
    "gen:image-styles": "node scripts/generate-image-style-assets.mjs",
    "validate:tokens": "tsx scripts/validate-template-tokens.ts",
    "deploy:all": "./scripts/deploy.sh all",
    "deploy:backend": "./scripts/deploy.sh backend",
    "deploy:creator": "./scripts/deploy.sh creator",
    "deploy:ecosystem": "./scripts/deploy.sh ecosystem",
    "deploy:healthz": "./scripts/deploy.sh healthz"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "tsx": "^4.19.2",
    "turbo": "^2.9.6",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
