    "@vue/test-utils": "^2.4.8",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@types/node": "^24.12.2",
    "eslint": "^10.2.1",
    "eslint-plugin-vue": "~10.9.0",
    "jsdom": "^29.0.2",
    "typescript": "~6.0.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=22.0.0"
  }
