{
  "name": "@big-ppt/slidev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./components-catalog": {
      "types": "./components/_catalog/index.ts",
      "import": "./components/_catalog/index.js"
    },
    "./global.css": "./global.css",
    "./templates/*": "./templates/*",
    "./layouts/*": "./layouts/*",
    "./components/*": "./components/*"
  },
  "scripts": {
