{
  "name": "@big-ppt/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e .env.development.local -e .env.local -- tsx watch src/index.ts",
    "build": "tsc",
    "start": "dotenv -e .env.production.local -- node dist/index.js",
    "type-check": "tsc --noEmit",
    "test": "dotenv -e .env.test.local -- vitest run",
    "test:smoke": "dotenv -e .env.test.local -- vitest run --testNamePattern='smoke' src/llm/__tests__/smoke",
    "test:watch": "dotenv -e .env.test.local -- vitest",
    "test:coverage": "dotenv -e .env.test.local -- vitest run --coverage",
    "lint": "eslint src test",
    "db:push": "dotenv -e .env.development.local -e .env.local -- drizzle-kit push",
    "db:push:test": "dotenv -e .env.test.local -- drizzle-kit push",
    "db:push:prod": "dotenv -e .env.production.local -- drizzle-kit push",
    "init-db": "node scripts/init-db.mjs",
    "init-test-db": "node scripts/init-test-db.mjs",
    "probe:duckcoding": "dotenv -e .env.test.local -- node scripts/probe-duckcoding.mjs",
    "migrate:llm-settings": "dotenv -e .env.development.local -e .env.local -- node scripts/migrate-llm-settings.mjs",
    "migrate:llm-settings:test": "dotenv -e .env.test.local -- node scripts/migrate-llm-settings.mjs",
    "migrate:llm-settings:prod": "dotenv -e .env.production.local -- node scripts/migrate-llm-settings.mjs",
    "migrate:deck-chats": "dotenv -e .env.development.local -e .env.local -- node scripts/migrate-deck-chats.mjs",
    "migrate:deck-chats:test": "dotenv -e .env.test.local -- node scripts/migrate-deck-chats.mjs",
    "migrate:deck-chats:prod": "dotenv -e .env.production.local -- node scripts/migrate-deck-chats.mjs",
    "migrate:thinking-level": "dotenv -e .env.development.local -e .env.local -- node scripts/migrate-thinking-level.mjs",
    "migrate:thinking-level:test": "dotenv -e .env.test.local -- node scripts/migrate-thinking-level.mjs",
    "migrate:thinking-level:prod": "dotenv -e .env.production.local -- node scripts/migrate-thinking-level.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.2",
    "@big-ppt/shared": "workspace:*",
    "@big-ppt/slidev": "workspace:*",
    "@earendil-works/pi-agent-core": "0.74.0",
    "@earendil-works/pi-ai": "0.74.0",
    "@google/genai": "^2.2.0",
    "@hono/node-server": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "bcrypt": "^6.0.0",
    "cookie": "^1.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "file-type": "^22.0.1",
    "hono": "^4.12.15",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "mysql2": "^3.22.2",
    "openai": "6.37.0",
    "pdf-parse": "^2.4.5",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^24.12.2",
    "@vitest/coverage-v8": "^4.1.5",
    "docx": "^9.6.1",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.2.1",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.19.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.0",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
