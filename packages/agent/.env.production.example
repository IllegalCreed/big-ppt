# ──────────────────────────────────────────────
# Lumideck Agent · 生产环境样板
# 真实值写到部署机器的 .env.production.local（绝不进 git；部署时由 ops 工具注入）
# 首次部署前必须重新生成 SESSION_SECRET 和 APIKEY_MASTER_KEY（一次即可，后续轮换需配套 re-encrypt 逻辑）
# ──────────────────────────────────────────────

NODE_ENV=production

# MySQL 生产连接串（部署时决定地址；内网 + TLS 推荐）
DATABASE_URL=mysql://lumideck_prod_user:REPLACE_ME@prod-host:3306/lumideck

# Session cookie 签名密钥（32 字节随机，换新）
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=REPLACE_ME_PROD_32_BYTES_HEX

# LLM API Key 加密 master key（32 字节随机；换新后所有 users.llm_settings 需要 re-encrypt）
APIKEY_MASTER_KEY=REPLACE_ME_PROD_32_BYTES_HEX

# Agent 端口（通常被反向代理承接，这里用内网端口即可）
AGENT_PORT=4000

# Slidev 反代目标（slidev v52 + Vite 5+ 默认 bind [::1] 即 IPv6 loopback;
# 用 localhost 让 OS resolver 自动选可达协议族,不要写 127.0.0.1 否则 ECONNREFUSED;
# Phase 10 部署期实测,详 plan 19 踩坑章节）
SLIDEV_ORIGIN=http://localhost:3031

# Phase 9-D：state-changing 请求的 Origin / Referer 白名单（CSRF second-line defense）
# 必须设置为生产域名 origin（含 protocol + host + port，无尾斜杠）；
# 未设时 originCheck 走 dev 兜底（允许 localhost / 127.0.0.1 任意端口），生产**必须显式**。
PUBLIC_ORIGIN=https://lumideck.example.com

# 可选：额外允许的 origin（CSV，预留 staging / preview 域名场景）
# PUBLIC_ORIGIN_EXTRA=https://staging.lumideck.example.com,https://preview.lumideck.example.com

# Phase 13:用户素材文件持久化目录(用户上传的 pdf/docx/png 等,字节落 fs,元数据入 DB)
# 默认 /tmp/lumideck-assets 仅 dev 用,生产必须显式设到持久卷;
# deploy_backend 会确保该路径在远端可写(chown lumideck;777 兜底)。
LUMIDECK_ASSETS_DIR=/var/lumideck/user-assets

# Phase 13:per-user / per-file 字节配额(默认 100MB / 10MB)
# 不设时 fallback 默认值,正式上线可选显式覆盖
# LUMIDECK_QUOTA_PER_USER_BYTES=104857600
# LUMIDECK_QUOTA_PER_FILE_BYTES=10485760

# Phase 15:.lumideck 归档包单次 import 大小上限(字节),默认 100MB
# LUMIDECK_IMPORT_MAX_BYTES=104857600
