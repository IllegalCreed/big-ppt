# Phase 10: Lumideck nginx 配置(模板,部署脚本 envsubst 后落到 /etc/nginx/conf.d/lumideck.conf)
#
# 占位符:
#   ${DOMAIN}        — 主域名,如 lumideck.illegalscreed.cn
#   ${WEB_ROOT}      — creator 静态文件目录,如 /var/www/lumideck
#   ${BACKEND_PORT}  — agent 监听端口,通常 4000
#
# 说明:
#   - HTTPS 证书行由 certbot --nginx 自动注入到此文件后(install-server.sh 跑 certbot 时);
#     首次 envsubst 出来时这些行不存在,certbot 注入后保留。
#   - 所有 /api/* 反代到 agent;agent 内部再反代到 Slidev(127.0.0.1:3031)。
#   - /@vite /@id /@fs /@server-ref /@server-reactive 等 Slidev/Vite 客户端绝对路径
#     也走 agent 反代(详见 packages/agent/src/index.ts 的 SLIDEV_EXTRA_PREFIXES)。
#   - WebSocket upgrade 头部全 location 都加,Slidev HMR / agent SSE 都依赖。

server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    # certbot.timer 自动续期(每 60 天)用 webroot 模式时,ACME challenge 走 80
    location /.well-known/acme-challenge/ {
        root ${WEB_ROOT};
        try_files $uri =404;
    }

    # 其他全部跳 HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${DOMAIN};

    # 由 install-server.sh 跑 certbot --webroot 后,这些证书路径已存在
    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # ACME 续期校验路径(certbot.timer 自动续期时用,与 80 端口配置一致)
    location /.well-known/acme-challenge/ {
        root ${WEB_ROOT};
        try_files $uri =404;
    }

    # 上传素材 / LLM 大对话 payload 留 buffer,默认 1m 太小
    client_max_body_size 20m;
    proxy_read_timeout 600s;
    proxy_send_timeout 600s;

    # gzip 压缩(对 Slidev iframe 内 Vite dev module 加载至关重要,
    # 实测无 gzip 时 925KB index.js 走 12 秒,加 gzip 后 ~250KB ~3 秒)
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript
               application/javascript application/x-javascript application/json
               application/xml application/xml+rss application/wasm
               font/woff2 image/svg+xml;

    # 安全头(Phase 9-D CSP report-only 已在 agent 注入,这里加补充层)
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # ── 前端 SPA(creator vite build dist) ─────────────────────
    root ${WEB_ROOT};
    index index.html;

    # SPA fallback:任何不存在的路径回 index.html 让 vue-router 处理
    location / {
        try_files $uri $uri/ /index.html;
    }

    # ── API + Slidev 反代到 agent ────────────────────────────
    location /api/ {
        proxy_pass http://127.0.0.1:${BACKEND_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket upgrade(Slidev HMR + agent SSE)
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # 流式 LLM 响应不要 buffer
        proxy_buffering off;
    }

    # ── 根 healthcheck(/healthz 别名,uptime 监控可单独打这条) ────
    location = /healthz {
        proxy_pass http://127.0.0.1:${BACKEND_PORT};
        proxy_set_header Host $host;
    }

    # ── Slidev / Vite 客户端绝对路径(agent 内部反代承接) ─────
    # 用 ^~ 让正则 location 优先级高于 SPA fallback
    location ^~ /@vite/ {
        proxy_pass http://127.0.0.1:${BACKEND_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }
    location ^~ /@id/ {
        proxy_pass http://127.0.0.1:${BACKEND_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }
    location ^~ /@fs/ {
        proxy_pass http://127.0.0.1:${BACKEND_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }
    location ^~ /@server-ref/ {
        proxy_pass http://127.0.0.1:${BACKEND_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }
    location ^~ /@server-reactive/ {
        proxy_pass http://127.0.0.1:${BACKEND_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }
}
