# Phase 10: Lumideck nginx 配置(模板,部署脚本 envsubst 后落到 /etc/nginx/conf.d/lumideck.conf)
#
# 占位符:
#   ${DOMAIN}        — 主域名,如 lumideck.illegalscreed.cn
#   ${WEB_ROOT}      — creator 静态文件目录,如 /var/www/lumideck
#   ${BACKEND_PORT}  — agent 监听端口,通常 4000
#
# 说明:
#   - HTTPS 证书行由 certbot --nginx 自动注入到此文件后(install-server.sh 跑 certbot 时);
#     首次 envsubst 出来时这些行不存在,certbot 注入后保留。
#   - 所有 /api/* 反代到 agent；creator 的公开分享路由由 SPA fallback 承接。

server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    # certbot.timer 自动续期(每 60 天)用 webroot 模式时,ACME challenge 走 80
    location /.well-known/acme-challenge/ {
        root ${WEB_ROOT};
        try_files $uri =404;
    }

    # 其他全部跳 HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${DOMAIN};

    # 由 install-server.sh 跑 certbot --webroot 后,这些证书路径已存在
    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # ACME 续期校验路径(certbot.timer 自动续期时用,与 80 端口配置一致)
    location /.well-known/acme-challenge/ {
        root ${WEB_ROOT};
        try_files $uri =404;
    }

    # 上传素材 / .lumideck 导入 / LLM 大对话 payload 留 buffer,与后端默认导入上限对齐
    client_max_body_size 100m;
    proxy_read_timeout 600s;
    proxy_send_timeout 600s;

    # gzip 压缩静态资源与 API 文本响应
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript
               application/javascript application/x-javascript application/json
               application/xml application/xml+rss application/wasm
               font/woff2 image/svg+xml;

    # 安全头(Phase 9-D CSP report-only 已在 agent 注入,这里加补充层)
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # ── 前端 SPA(creator vite build dist) ─────────────────────
    root ${WEB_ROOT};
    index index.html;

    # SPA fallback:任何不存在的路径回 index.html 让 vue-router 处理
    location / {
        try_files $uri $uri/ /index.html;
    }

    # ── API 反代到 agent ────────────────────────────────────
    location /api/ {
        proxy_pass http://127.0.0.1:${BACKEND_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # HTTP/1.1 + 关闭 buffering，保证 LLM SSE 流及时抵达浏览器。
        proxy_http_version 1.1;
        proxy_buffering off;
    }

    # ── 根 healthcheck(/healthz 别名,uptime 监控可单独打这条) ────
    location = /healthz {
        proxy_pass http://127.0.0.1:${BACKEND_PORT};
        proxy_set_header Host $host;
    }
}
