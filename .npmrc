# for pnpm
shamefully-hoist=true
auto-install-peers=true

# Phase 9-F：drizzle-kit 通过 import('mysql2') 检测 driver 可用性，从 .pnpm/drizzle-kit/
# 自己的 node_modules 一路向上查找；mysql2 仅 packages/agent 一个包用、pnpm 不自动 hoist
# 到根 node_modules，导致 `pnpm db:push` 报 "please install ... mysql2"。public-hoist 强制导出。
public-hoist-pattern[]=mysql2
